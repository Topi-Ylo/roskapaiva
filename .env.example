# Supabase project credentials (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4 measurement ID (e.g. G-ABC123DEF). Leave blank to disable.
VITE_GA_MEASUREMENT_ID=G-Z77PF0Z92V

# --- Netlify Functions only (server side, never exposed to the browser) ---
# Supabase service role key, used to approve submissions and read organiser
# e-mail addresses. Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Resend (https://resend.com) API key + a verified sender on your domain.
RESEND_API_KEY=
RESEND_FROM=Roskapäivä <no-reply@roskapaiva.fi>
# Where approval notifications are sent, and the site's public base URL.
ADMIN_EMAIL=eino@roskapaiva.com
SITE_URL=https://roskapaiva.fi
